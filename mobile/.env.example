# Copy to .env.local. Use the same Clerk instance and Supabase project as the website.
# Only public/publishable keys belong in this app. Never put a Supabase secret/service-role key here.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
