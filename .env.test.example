# Copy this file to .env.local for local development. Use only non-production accounts and data.
NEXT_PUBLIC_SUPABASE_URL=https://your-non-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-non-production-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-your-clerk-development-key
CLERK_SECRET_KEY=sk_test_replace-with-your-clerk-development-secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
